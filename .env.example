# ---------------------------------------------------------------------------
# Intendencia de Aulas - variables de entorno del proyecto
# Copiar a .env.local (nunca versionar valores reales)
# ---------------------------------------------------------------------------

# Secreto para firmar la cookie de sesión del login simulado.
# En producción usar un valor aleatorio de al menos 32 caracteres.
SESSION_SECRET=cambiar-este-valor-en-produccion

# Directorio de datos de PGlite (opcional).
# Por defecto: app/db/pglite-data
# PGLITE_DATA_DIR=./db/pglite-data

# --- Integraciones futuras (no usadas por el MVP simulado) -----------------
# AUTH_MODE=mock | google
AUTH_MODE=mock
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DATABASE_URL=postgres://usuario:clave@localhost:5432/intendencia

# --- OpenCode / MCP --------------------------------------------------------
# API key de Context7 para el MCP remoto (opcional).
# CONTEXT7_API_KEY=
